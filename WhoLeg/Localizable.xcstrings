    "スマホを左右に傾けて森の中を進む！缶に注意して新記録を目指そう" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neige dein Handy nach links und rechts, um durch den Wald zu laufen! Achte auf Dosen und stell einen neuen Rekord auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilt your phone left and right to move through the forest! Watch out for cans and set a new record"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Inclina el móvil a izquierda y derecha para avanzar por el bosque! Cuidado con las latas y bate tu récord"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline ton téléphone à gauche et à droite pour avancer dans la forêt ! Attention aux canettes et bats ton record"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miringkan ponsel ke kiri dan kanan untuk melewati hutan! Hati-hati dengan kaleng dan pecahkan rekor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina il telefono a destra e sinistra per avanzare nella foresta! Attento alle lattine e batti il record"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트폰을 좌우로 기울여 숲속을 나아가자! 캔을 조심하며 신기록에 도전"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantel je telefoon naar links en rechts om door het bos te gaan! Pas op voor blikjes en zet een nieuw record"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechylaj telefon w lewo i w prawo, by iść przez las! Uważaj na puszki i pobij rekord"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incline o celular para os lados para avançar pela floresta! Cuidado com as latas e bata o recorde"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอียงมือถือซ้ายขวาเพื่อเดินผ่านป่า! ระวังกระป๋องแล้วทำสถิติใหม่กันเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunu sağa sola eğerek ormanda ilerle! Kutulara dikkat et ve yeni rekor kır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghiêng điện thoại trái phải để băng qua khu rừng! Coi chừng lon và lập kỷ lục mới"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右倾斜手机在森林中前进！小心罐子，挑战新纪录吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右傾斜手機在森林中前進！小心罐子，挑戰新紀錄吧"
          }
        }
      }
    },
