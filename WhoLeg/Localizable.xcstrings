    "dualshock4でtoioを簡単操作！\n本アプリを利用するにはtoioが必要です" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toio ganz einfach mit dem DUALSHOCK 4 steuern!\nFür diese App wird toio benötigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control toio easily with a DUALSHOCK 4!\ntoio is required to use this app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Controla toio fácilmente con un DUALSHOCK 4!\nNecesitas toio para usar esta app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle toio facilement avec une DUALSHOCK 4 !\ntoio est requis pour utiliser cette app"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendalikan toio dengan mudah memakai DUALSHOCK 4!\nAplikasi ini memerlukan toio"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla toio facilmente con un DUALSHOCK 4!\nPer usare questa app serve toio"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DUALSHOCK 4로 toio를 간편하게 조작!\n이 앱을 사용하려면 toio가 필요합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestuur toio eenvoudig met een DUALSHOCK 4!\nVoor deze app heb je toio nodig"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łatwe sterowanie toio za pomocą DUALSHOCK 4!\nDo korzystania z aplikacji potrzebne jest toio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle o toio facilmente com um DUALSHOCK 4!\nÉ necessário ter um toio para usar este app"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควบคุม toio ได้ง่ายๆ ด้วย DUALSHOCK 4!\nต้องมี toio เพื่อใช้แอปนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toio'yu DUALSHOCK 4 ile kolayca kontrol et!\nBu uygulamayı kullanmak için toio gerekir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều khiển toio dễ dàng bằng DUALSHOCK 4!\nCần có toio để sử dụng ứng dụng này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用DUALSHOCK 4轻松操控toio！\n使用本应用需要toio"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用DUALSHOCK 4輕鬆操控toio！\n使用本App需要toio"
          }
        }
      }
