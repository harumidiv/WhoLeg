    "エビフライが空を飛ぶ！？きれいに揚げて宇宙を目指そう！" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frittierte Garnelen fliegen?! Frittiere sie perfekt und flieg ins All!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fried shrimp can fly?! Fry it perfectly and aim for space!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿¡Un langostino frito que vuela!? ¡Fríelo bien y llega al espacio!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une crevette frite qui vole ?! Fais-la bien frire et vise l'espace !"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udang goreng bisa terbang?! Goreng dengan sempurna dan menuju luar angkasa!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gambero fritto che vola?! Friggilo a puntino e punta allo spazio!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새우튀김이 하늘을 난다!? 예쁘게 튀겨서 우주를 향해 가자!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefrituurde garnalen die vliegen?! Bak ze perfect en ga naar de ruimte!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smażona krewetka lata?! Usmaż ją idealnie i leć w kosmos!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camarão empanado voando?! Frite direitinho e mire o espaço!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กุ้งทอดบินได้!? ทอดให้สวยแล้วมุ่งสู่อวกาศกันเลย!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kızarmış karides uçuyor mu?! Güzelce kızart ve uzaya ulaşmaya çalış!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôm chiên bay lên trời?! Chiên thật ngon và hướng tới vũ trụ nào!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炸虾竟然会飞？！把它炸得漂漂亮亮，向太空出发吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炸蝦竟然會飛？！把它炸得漂漂亮亮，朝太空出發吧！"
          }
        }
      }
    },
